# RPC for Sepolia. Blank falls back to the public node (rate limited but works).
# Free alternatives: Alchemy, Infura, drpc.org
SEPOLIA_RPC_URL=

# Private key of a Sepolia account with ~0.1 test ETH.
# USE A THROWAWAY KEY. Never a key that holds real funds.
DEPLOYER_PRIVATE_KEY=

# https://etherscan.io/apis — only needed for `hardhat verify`
ETHERSCAN_API_KEY=
