# ---- Wallet / chain ----------------------------------------------------------
# Required. Free project id from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Chain the deployed contracts live on. 11155111 = Sepolia, 84532 = Base Sepolia,
# 31337 = local Hardhat (default).
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111

# Optional custom RPCs. Blank falls back to the chain's public RPC (rate limited).
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# ---- Deployed contract addresses --------------------------------------------
# Filled in from `npx hardhat ignition deploy ... --network sepolia` output.
NEXT_PUBLIC_WALLET_ADDRESS=
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=
NEXT_PUBLIC_LIQUIDITY_POOL_ADDRESS=
NEXT_PUBLIC_TRANSFER_ADDRESS=
NEXT_PUBLIC_ANOMALY_GUARD_ADDRESS=
# ERC-20 paired with the liquidity pool (used by /liquidity)
NEXT_PUBLIC_TOKEN_FACTORY_LP_ADDRESS=

# ---- Server-side secrets (never NEXT_PUBLIC_) --------------------------------
# MongoDB Atlas free tier connection string. Without it /api/savecoin returns 500.
MONGODB_URI=
# https://aistudio.google.com/apikey — powers the natural-language transfer parser
GOOGLE_GENERATIVE_AI_API_KEY=
# https://api.imgbb.com — optional, token logo uploads
IMGBB_API_KEY=
# https://coinmarketcap.com/api — optional, /api/crypto falls back to static prices
NEXT_PUBLIC_COIN_BACK_API_KEY=
